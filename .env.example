# Artha React Native Frontend Configuration
# Note: Never place backend secrets, database URLs, or OAuth client secrets in frontend configuration.

# Backend API Base URL (defaults to http://localhost:3000/api/v1 on iOS Simulator and http://10.0.2.2:3000/api/v1 on Android Emulator)
ARTHA_API_BASE_URL=http://localhost:3000/api/v1

# Google OAuth Public Client Identifiers (from Google Cloud Console)
ARTHA_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
ARTHA_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
ARTHA_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.your-ios-client-id
ARTHA_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
